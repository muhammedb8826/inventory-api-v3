DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=stock_management
DB_SYNCHRONIZE=false
DB_LOGGING=false

PORT=3001

JWT_AT_SECRET=change-me-access-secret
JWT_RT_SECRET=change-me-refresh-secret
JWT_AT_EXPIRES_IN=1d
JWT_RT_EXPIRES_IN=7d

DB_SEED=true
SEED_ADMIN_EMAIL=admin@stock.local
SEED_ADMIN_PASSWORD=Admin@123

# Comma-separated; http://localhost:3000 is always allowed for local frontend dev
CORS_ORIGIN=https://noblestore.net,http://localhost:3000

# Absolute API origin for uploaded assets (no trailing slash). Optional; request host used if empty.
PUBLIC_BASE_URL=

# Display currency (amounts are stored as decimal numbers; no FX conversion)
CURRENCY=ETB
CURRENCY_SYMBOL=Br



# 1) Create tables from entities
# npx typeorm-ts-node-commonjs schema:sync -d src/database/data-source.ts

# 2) Then apply the incremental migrations
# npm run migration:run

# 3) Seed roles/admin/etc.
# npm run seed